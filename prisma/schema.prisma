generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                    @id @default(cuid())
  email                     String                    @unique
  password                  String // 密码
  role                      String                    @default("user") // user, super_admin
  isBanned                  Boolean                   @default(false)
  planType                  String                    @default("free") // free, points, byok
  creditBalance             Int                       @default(0)
  creditBalanceCents        Int                       @default(0)
  // Canonical balance for new billing code. Legacy integer fields remain for
  // compatibility with existing deployments and are kept in sync.
  creditBalanceAmount       Decimal                   @default(0) @db.Decimal(12, 2)
  signupBonusGrantedAt      DateTime?
  proAccessActivatedAt      DateTime?
  proAccessExpiresAt        DateTime?
  pendingProAccessDays      Int                       @default(0)
  pendingProAccessExpiresAt DateTime?
  freeQuotaDate             String?
  freeQuotaUsed             Int                       @default(0)
  name                      String?
  image                     String?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  settings                  UserSettings?
  audits                    Audit[]
  pointTransactions         PointTransaction[]
  purchaseOrders            PurchaseOrder[]
  rateLimitEvents           RateLimitEvent[]
  extensionSessions         ExtensionSession[]
  extensionLinkCodes        ExtensionLinkCode[]
  auditJobs                 AuditJob[]
  emailDeliveries           EmailDelivery[]
  rssFeeds                  RssFeed[]
  discussionMessages        ReportDiscussionMessage[]
  discussionReports         DiscussionReport[]        @relation("DiscussionReporter")
  exportArtifacts           ExportArtifact[]
  modelUsageEvents          ModelUsageEvent[]
}

model UserSettings {
  id                           String   @id @default(cuid())
  userId                       String   @unique
  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultModelName             String   @default("gpt-4o")
  llmBaseUrl                   String   @default("https://api.openai.com/v1")
  llmApiKeyEncrypted           String?
  enableTavilySearch           Boolean  @default(false)
  tavilyApiKeyEncrypted        String?
  tavilySearchDepth            String   @default("basic") // basic, advanced
  enableSerperSearch           Boolean  @default(false)
  serperApiKeyEncrypted        String?
  defaultAudienceTheme         String   @default("youth") // teen, youth, mature, senior
  defaultReportLanguage        String   @default("zh-CN") // zh-CN, en-US
  defaultReasoningDepth        String   @default("medium") // none, low, medium, high, extreme
  defaultAnalysisMode          String   @default("quick") // quick, deep
  defaultIsPublic              Boolean  @default(true)
  defaultSaveResult            Boolean  @default(true)
  defaultEnableCharts          Boolean  @default(true)
  modelSource                  String   @default("platform") // platform, custom
  defaultPlatformModelConfigId String?
  rssFeedUrlsJson              String   @default("[]")
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model Audit {
  id                            String                    @id @default(cuid())
  userId                        String
  user                          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                         String
  source                        String
  publishedAt                   String
  publishedAtSource             String                    @default("unknown")
  publishedAtConfidence         String                    @default("unknown")
  reportType                    String                    @default("deep")
  readingValue                  String                    @default("材料不足")
  originalContent               String
  focus                         String?
  analysisMode                  String // quick, deep
  reportLanguage                String                    @default("zh-CN") // zh-CN, en-US
  reasoningDepth                String // none, low, medium, high, extreme
  modelName                     String
  platformModelConfigIdSnapshot String?
  modelDisplayNameSnapshot      String?
  modelProviderSnapshot         String?
  modelSearchModeSnapshot       String?
  modelMultiplierBpsSnapshot    Int?
  modelConfigVersionSnapshot    Int?
  modelCreditCostCents          Int?
  newsSummary                   String
  auditResultJson               String // 存储完整结构化审视结果
  credibilityScore              Int                       @default(0)
  informationCompletenessScore  Int                       @default(0)
  narrativeBiasScore            Int                       @default(0)
  evidenceStrengthScore         Int                       @default(0)
  speculationRiskScore          Int                       @default(0)
  viewCount                     Int                       @default(0)
  heatScore                     Int                       @default(0)
  isPublic                      Boolean                   @default(true)
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt
  completionMarkdown            String?
  completionGeneratedAt         DateTime?
  reportVersion                 Int                       @default(1)
  discussionLockedAt            DateTime?
  discussionLockedById          String?
  emailDeliveries               EmailDelivery[]
  discussionMessages            ReportDiscussionMessage[]
  exportArtifacts               ExportArtifact[]

  @@index([userId])
  @@index([heatScore])
  @@index([createdAt])
}

model AuditJob {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            String   @default("pending") // pending, running, completed, failed
  inputJson         String
  modelSnapshotJson String?
  creditCostCents   Int?
  auditId           String?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model EmailDelivery {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  auditId      String?
  audit        Audit?    @relation(fields: [auditId], references: [id], onDelete: SetNull)
  category     String
  recipient    String
  subject      String
  provider     String?
  status       String    @default("pending") // pending, sent, failed
  attempts     Int       @default(0)
  error        String?
  metadataJson String    @default("{}")
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([auditId])
  @@index([status, createdAt])
}

model AppSetting {
  id                         String   @id @default("global")
  adminModelName             String   @default("gpt-4o")
  adminLlmBaseUrl            String   @default("https://api.openai.com/v1")
  adminLlmApiKeyEncrypted    String?
  adminTavilyApiKeyEncrypted String?
  adminSerperApiKeyEncrypted String?
  enableAdminTavilySearch    Boolean  @default(false)
  enableAdminSerperSearch    Boolean  @default(false)
  adminRssFeedIdsJson        String   @default("[]")
  alipayQrImageUrl           String   @default("/alipay-qr.jpg")
  alipayPointsQrImageUrl     String   @default("/alipay-points.jpg")
  alipayByokQrImageUrl       String   @default("/alipay-byok.jpg")
  paypalQrImageUrl           String   @default("/paypal-qr.jpg")
  paypalStarterCreditsUrl    String?
  paypalProCreditsUrl        String?
  alipayStarterCreditsUrl    String?
  alipayProCreditsUrl        String?
  alipayQrNote               String   @default("6 元购买 30 点；30 元买断后可填写自己的大模型和搜索 API。付款备注请填写账号邮箱、昵称或转账时间。")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model PlatformModelConfig {
  id                                String    @id @default(cuid())
  configKey                         String    @unique
  provider                          String    @default("openai_compatible") // openai_compatible, openai, gemini, anthropic
  displayName                       String
  description                       String    @default("")
  displayNameI18nJson               String    @default("{}")
  descriptionI18nJson               String    @default("{}")
  baseUrl                           String
  apiKeyEncrypted                   String?
  modelId                           String
  reasoningDepth                    String    @default("medium")
  searchMode                        String    @default("platform") // platform, native, none
  supportsAnalysis                  Boolean   @default(true)
  supportsCompletion                Boolean   @default(true)
  supportsFollowup                  Boolean   @default(true)
  creditMultiplierBps               Int       @default(100)
  inputPriceMicrosPerMillion        Int       @default(0)
  outputPriceMicrosPerMillion       Int       @default(0)
  nativeSearchPriceMicrosPerRequest Int       @default(0)
  isEnabled                         Boolean   @default(true)
  isVisibleToUsers                  Boolean   @default(true)
  isRecommended                     Boolean   @default(false)
  isDefault                         Boolean   @default(false)
  sortOrder                         Int       @default(0)
  configVersion                     Int       @default(1)
  lastTestStatus                    String?
  lastTestMessage                   String?
  lastTestedAt                      DateTime?
  archivedAt                        DateTime?
  createdAt                         DateTime  @default(now())
  updatedAt                         DateTime  @updatedAt

  @@index([isEnabled, isVisibleToUsers, sortOrder])
  @@index([isDefault])
  @@index([archivedAt])
}

model ModelUsageEvent {
  id                            String   @id @default(cuid())
  userId                        String?
  user                          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  auditId                       String?
  jobId                         String?
  operation                     String
  status                        String
  usageSource                   String   @default("platform")
  platformModelConfigIdSnapshot String?
  modelDisplayNameSnapshot      String?
  modelNameSnapshot             String?
  modelProviderSnapshot         String?
  modelConfigVersionSnapshot    Int?
  modelMultiplierBpsSnapshot    Int?
  creditCostCents               Int      @default(0)
  inputTokens                   Int      @default(0)
  outputTokens                  Int      @default(0)
  cacheReadTokens               Int      @default(0)
  searchRequestCount            Int      @default(0)
  nativeSearchRequestCount      Int      @default(0)
  estimatedExternalCostMicros   Int      @default(0)
  durationMs                    Int      @default(0)
  errorCode                     String?
  createdAt                     DateTime @default(now())

  @@index([platformModelConfigIdSnapshot, createdAt])
  @@index([userId, createdAt])
  @@index([operation, status, createdAt])
}

model PointTransaction {
  id                         String   @id @default(cuid())
  userId                     String
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta                      Int
  balanceAfter               Int
  deltaCents                 Int?
  balanceAfterCents          Int?
  amount                     Decimal  @default(0) @db.Decimal(12, 2)
  balanceBefore              Decimal  @default(0) @db.Decimal(12, 2)
  balanceAfterAmount         Decimal  @default(0) @db.Decimal(12, 2)
  transactionType            String   @default("ADMIN_ADJUSTMENT")
  relatedTaskId              String?
  relatedReportVersion       Int?
  relatedDiscussionMessageId String?
  idempotencyKey             String?
  modelConfigIdSnapshot      String?
  modelDisplayNameSnapshot   String?
  modelNameSnapshot          String?
  modelMultiplierBpsSnapshot Int?
  modelConfigVersionSnapshot Int?
  type                       String // consume, grant, purchase, refund
  reason                     String
  auditId                    String?
  orderId                    String?
  createdAt                  DateTime @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([createdAt])
}

model PurchaseOrder {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageType           String    @default("points_30") // points_30, byok_lifetime
  productId             String    @default("STARTER")
  packageName           String    @default("30 点套餐")
  amountCents           Int       @default(600)
  currency              String    @default("CNY")
  points                Int       @default(30)
  proAccessDays         Int       @default(0)
  status                String    @default("PENDING") // PENDING, PAYMENT_SUBMITTED, PAID, FULFILLED, REJECTED, REFUNDED, CANCELLED
  paymentMethod         String    @default("alipay_qr")
  paymentNote           String?
  adminNote             String?
  confirmedAt           DateTime?
  paidAt                DateTime?
  fulfilledAt           DateTime?
  paymentProvider       String?
  providerTransactionId String?   @unique
  paymentEmail          String?
  webhookEventId        String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model RssFeed {
  id                  String    @id @default(cuid())
  sourceType          String    @default("USER") // ADMIN, USER
  ownerUserId         String?
  owner               User?     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name                String
  url                 String
  isEnabled           Boolean   @default(true)
  lastFetchedAt       DateTime?
  lastError           String?
  lastManualRefreshAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  items               RssItem[]

  @@unique([ownerUserId, url])
  @@index([sourceType, isEnabled])
  @@index([ownerUserId])
}

model RssItem {
  id             String    @id @default(cuid())
  feedId         String
  feed           RssFeed   @relation(fields: [feedId], references: [id], onDelete: Cascade)
  externalId     String
  title          String
  url            String
  author         String?
  summary        String?
  contentSnippet String?
  publishedAt    DateTime?
  imageUrl       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([feedId, externalId])
  @@index([feedId, publishedAt])
}

model ReportDiscussionMessage {
  id                  String                    @id @default(cuid())
  reportId            String
  report              Audit                     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportVersionAtPost Int                       @default(1)
  userId              String
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentMessageId     String?
  parent              ReportDiscussionMessage?  @relation("DiscussionReplies", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies             ReportDiscussionMessage[] @relation("DiscussionReplies")
  content             String
  contentFormat       String                    @default("plain")
  languageCode        String                    @default("zh-CN")
  status              String                    @default("VISIBLE") // VISIBLE, HIDDEN, DELETED, PENDING_REVIEW
  isEdited            Boolean                   @default(false)
  editedAt            DateTime?
  deletedAt           DateTime?
  pointTransactionId  String?
  idempotencyKey      String
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  reports             DiscussionReport[]

  @@unique([userId, idempotencyKey])
  @@index([reportId, createdAt])
  @@index([parentMessageId])
}

model DiscussionReport {
  id             String                  @id @default(cuid())
  messageId      String
  message        ReportDiscussionMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterUserId String
  reporter       User                    @relation("DiscussionReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reason         String
  description    String?
  status         String                  @default("PENDING")
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime                @default(now())

  @@unique([messageId, reporterUserId])
  @@index([status, createdAt])
}

model ExportArtifact {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId              String
  report                Audit    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportVersion         Int
  exportFormat          String // PDF, MARKDOWN
  templateVersion       String   @default("1")
  contentHash           String
  storagePath           String?
  content               String?
  downloadFilename      String
  fileHash              String?
  fileSizeBytes         Int?
  pageCount             Int?
  language              String
  status                String   @default("PENDING") // PENDING, GENERATING, READY, FAILED, DELETED
  pointTransactionId    String?
  errorCode             String?
  errorMessageSanitized String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, reportId, reportVersion, exportFormat])
  @@index([reportId, reportVersion])
}

model VerificationCode {
  id           String    @id @default(cuid())
  email        String
  codeHash     String
  purpose      String    @default("register")
  expiresAt    DateTime
  consumedAt   DateTime?
  ipHash       String?
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([email])
  @@index([purpose])
  @@index([createdAt])
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  createdAt DateTime @default(now())

  @@index([userId, action, createdAt])
}

model ExtensionLinkCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ExtensionSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  name       String
  browser    String?
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([lastUsedAt])
}
