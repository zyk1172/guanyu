{
  "name": "news-analyzer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "ci": "npm run lint && npm run test:report && npm run test:report-schema && npm run test:round2 && npm run test:backup && npm run test:platform-models && npm run test:analyze-job && npm run test:model-runtime && npm run test:permissions && npm run build",
    "test:report": "node --test scripts/report-logic.test.mjs",
    "test:report-schema": "tsx --test scripts/report-schema.test.ts",
    "test:round2": "tsx --test scripts/round2-security.test.ts",
    "reset:business-data": "tsx scripts/reset-business-data.ts",
    "test:pdf": "tsx scripts/pdf-smoke.ts",
    "test:word": "tsx scripts/docx-smoke.ts",
    "test:exports-i18n": "tsx scripts/multilingual-export-smoke.ts",
    "test:backup": "tsx scripts/backup-smoke.ts",
    "test:permissions": "tsx scripts/ordinary-user-permission-smoke.ts",
    "seed:ci": "tsx scripts/seed-ci.ts",
    "test:platform-models": "node --test scripts/platform-model-core.test.mjs",
    "test:analyze-job": "node --test scripts/analyze-job.test.mjs",
    "test:model-runtime": "tsx --test scripts/model-runtime.test.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@heroicons/react": "^2.2.0",
    "@libsql/client": "^0.17.4",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "7.9.1",
    "@types/qrcode": "^1.5.6",
    "@upstash/redis": "^1.38.2",
    "cheerio": "^1.2.0",
    "docx": "^9.7.1",
    "fast-xml-parser": "^5.11.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "next-auth": "4.24.15",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "prisma": "7.9.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3",
    "@prisma/adapter-pg": "7.9.1",
    "dotenv": "^17.4.2"
  },
  "overrides": {
    "undici": "7.29.0",
