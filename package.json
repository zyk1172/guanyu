{
  "name": "news-analyzer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "ci": "npm run lint && npm run test:report && npm run test:round2 && npm run test:backup && npm run test:platform-models && npm run test:model-runtime && npm run build",
    "test:report": "node --test scripts/report-logic.test.mjs",
    "test:round2": "tsx --test scripts/round2-security.test.ts",
    "reset:business-data": "node scripts/reset-business-data.mjs",
    "test:pdf": "tsx scripts/pdf-smoke.ts",
    "test:word": "tsx scripts/docx-smoke.ts",
    "test:exports-i18n": "tsx scripts/multilingual-export-smoke.ts",
    "test:backup": "tsx scripts/backup-smoke.ts",
    "test:permissions": "tsx scripts/ordinary-user-permission-smoke.ts",
    "test:platform-models": "node --test scripts/platform-model-core.test.mjs",
    "test:model-runtime": "tsx --test scripts/model-runtime.test.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@heroicons/react": "^2.2.0",
    "@libsql/client": "^0.17.4",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.4.1",
    "@types/qrcode": "^1.5.6",
    "@upstash/redis": "^1.38.0",
    "cheerio": "^1.2.0",
    "docx": "^9.7.1",
    "fast-xml-parser": "^5.10.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-auth": "4.24.12",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "prisma": "^6.4.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
